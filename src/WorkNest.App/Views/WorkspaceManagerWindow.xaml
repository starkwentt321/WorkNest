<Window x:Class="WorkNest.App.Views.WorkspaceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理工作区"
        Icon="/WorkNest;component/Assets/app.ico"
        Width="380" Height="500"
        MinWidth="320" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}"
        FontSize="12"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 窗口内错误提示（决策 89） -->
        <TextBlock Grid.Row="0" Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap" Margin="0,0,0,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 工作区列表：文件夹图标 + 名称 + 资源数（F01/决策 39） -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                 Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Image Source="{Binding Icon}" Width="20" Height="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource FgSecondary}"
                                   Text="{Binding ResourceCount, StringFormat='{}{0} 项'}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelected}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- 新建（内联输入）/ 重命名（决策 45） -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="新建" Width="56" Command="{Binding CreateCommand}"/>
            <Button DockPanel.Dock="Right" Content="重命名" Width="56" Margin="6,0,0,0" Command="{Binding RenameCommand}"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.ToolTip>输入名称后新建；选中工作区时输入新名称可重命名</TextBox.ToolTip>
            </TextBox>
        </DockPanel>

        <!-- 排列与删除 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="恢复最近使用排序" Command="{Binding RestoreLastUsedCommand}"
                    ToolTip="恢复按最近使用时间排序（决策 45）"/>
            <Button DockPanel.Dock="Right" Content="下移" Width="56" Margin="6,0,6,0" Command="{Binding MoveDownCommand}"/>
            <Button DockPanel.Dock="Right" Content="上移" Width="56" Command="{Binding MoveUpCommand}"/>
            <Button Content="删除" Width="56" HorizontalAlignment="Left" Command="{Binding DeleteCommand}"/>
        </DockPanel>

        <Button Grid.Row="4" Content="关闭" Width="72" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True"/>
    </Grid>
</Window>
