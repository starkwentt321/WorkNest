<Window x:Class="WorkNest.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出配置"
        Icon="/WorkNest;component/Assets/app.ico"
        Width="460" Height="430"
        MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}"
        FontSize="12"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要导出的工作区（决策 64：支持全部或部分导出）"
                   FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- 工作区勾选清单 -->
        <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="5" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="8,0,0,0">
                    <Button Content="全选" Command="{Binding SelectAllCommand}" Padding="8,2"/>
                    <Button Content="全不选" Command="{Binding SelectNoneCommand}" Padding="8,2" Margin="0,6,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Margin="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ResourceCount, StringFormat='（{0} 项）'}"
                                                   Foreground="{DynamicResource FgSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 导出位置 -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="浏览…" Width="56" Margin="6,0,0,0" Command="{Binding BrowseCommand}"/>
            <TextBox Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 敏感信息提醒（决策 96）+ 结果/错误回显 -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="导出文件为明文 JSON，包含本机的真实文件路径、目录与网址等敏感信息，请妥善保管。"
                       Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="导出" Width="72" Style="{StaticResource AccentButtonStyle}" Command="{Binding ExportCommand}"/>
            <Button Content="关闭" Width="72" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
