<Window x:Class="WorkNest.App.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入预览"
        Icon="/WorkNest;component/Assets/app.ico"
        Width="540" Height="470"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}"
        FontSize="12"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="OverwriteToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SummaryText}" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- 预览明细：工作区 / 状态 / 新增 / 复用 / 无效 / 策略（决策 75/84） -->
        <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="5" Padding="4">
            <ListView ItemsSource="{Binding Workspaces}" HorizontalContentAlignment="Stretch">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="工作区" Width="108" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="状态" Width="72" DisplayMemberBinding="{Binding StatusText}"/>
                        <GridViewColumn Header="新增" Width="46" DisplayMemberBinding="{Binding NewCount}"/>
                        <GridViewColumn Header="复用" Width="46" DisplayMemberBinding="{Binding ReuseCount}"/>
                        <GridViewColumn Header="无效" Width="46" DisplayMemberBinding="{Binding InvalidCount}"/>
                        <GridViewColumn Header="处理方式" Width="168">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Strategies}"
                                              SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                                              DisplayMemberPath="Value"
                                              SelectedValuePath="Key"
                                              IsEnabled="{Binding IsConflict}"
                                              MinWidth="150"
                                              ToolTip="同名冲突的处理方式（决策 84）：合并 / 创建副本 / 跳过 / 覆盖"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <!-- 覆盖导入提示（决策 85：安全快照由服务层自动创建） -->
            <TextBlock Text="包含覆盖导入：执行前将自动创建当前状态的安全快照。"
                       Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap"
                       Visibility="{Binding HasOverwrite, Converter={StaticResource OverwriteToVis}}"/>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="执行导入" Width="88" Style="{StaticResource AccentButtonStyle}" Command="{Binding ExecuteImportCommand}"/>
            <Button Content="取消" Width="72" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
