<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      深色调色板（决策 13/18：浅色/深色切换）。
      与 Palette.Light.xaml 键位完全一致，切换 = ThemeManager 替换窗口合并字典。
    -->
    <SolidColorBrush x:Key="Bg" Color="#202020"/>
    <SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Input" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Fg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="FgDisabled" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="InvalidFg" Color="#7A7A7A"/>

    <SolidColorBrush x:Key="Accent" Color="#479EF5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#62ABF0"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#2E7CC4"/>
    <SolidColorBrush x:Key="AccentFg" Color="#0B0B0B"/>

    <SolidColorBrush x:Key="Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Hover" Color="#383838"/>
    <SolidColorBrush x:Key="Pressed" Color="#414141"/>
    <SolidColorBrush x:Key="RowHover" Color="#333333"/>
    <SolidColorBrush x:Key="RowSelected" Color="#234A68"/>

    <SolidColorBrush x:Key="ErrorBg" Color="#3A2E1D"/>
    <SolidColorBrush x:Key="ErrorBorder" Color="#8A6A2F"/>
    <SolidColorBrush x:Key="ErrorFg" Color="#F0D8A8"/>

    <SolidColorBrush x:Key="Header" Color="#262626"/>
    <SolidColorBrush x:Key="HeaderHover" Color="#303030"/>
    <SolidColorBrush x:Key="Menu" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="MenuHover" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#454545"/>
    <SolidColorBrush x:Key="MenuSeparator" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="PinStar" Color="#F0C24B"/>
</ResourceDictionary>
