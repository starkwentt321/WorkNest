<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      浅色调色板（决策 30：首次主题浅色）。
      只定义颜色 token；控件结构与键位见 Controls.xaml，深色主题在 Palette.Dark.xaml 中使用相同键位。
    -->
    <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Fg" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#616161"/>
    <SolidColorBrush x:Key="FgDisabled" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="InvalidFg" Color="#9E9E9E"/>

    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentHover" Color="#115EA3"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#0C3B5E"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Border" Color="#D1D1D1"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Hover" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Pressed" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="RowHover" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="RowSelected" Color="#D6E7F7"/>

    <!-- 错误横幅：浅橙底（决策 89：普通错误窗口内提示，不弹窗） -->
    <SolidColorBrush x:Key="ErrorBg" Color="#FDF3E2"/>
    <SolidColorBrush x:Key="ErrorBorder" Color="#E5B267"/>
    <SolidColorBrush x:Key="ErrorFg" Color="#4D3800"/>

    <SolidColorBrush x:Key="Header" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="HeaderHover" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="Menu" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuHover" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="MenuSeparator" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="PinStar" Color="#E8A317"/>
</ResourceDictionary>
