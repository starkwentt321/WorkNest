<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 平台适配层：Shell 启动、托盘、热键、单实例、图标提取、开机启动 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘 NotifyIcon 与消息窗口来自 WinForms；仅在本层使用，不外溢 -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI 注册扩展需要 IServiceCollection；版本与 App 层 Microsoft.Extensions.DependencyInjection 10.0.0 对齐 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkNest.Application\WorkNest.Application.csproj" />
  </ItemGroup>

</Project>
